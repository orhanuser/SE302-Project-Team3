sequenceDiagram
    actor User as Student Affairs
    participant Controller as ScheduleController
    participant Assigner as InvigilatorAssigner
    participant Repo as DataRepository
    participant Alloc as ClassroomAllocation
    participant Inv as Invigilator

    User->>Controller: Assign invigilators
    Controller->>Assigner: assign(schedule)
    Assigner->>Repo: loadExamPeriod()
    Repo-->>Assigner: examPeriod
    Assigner->>Repo: loadCurrentData(INVIGILATORS)
    Repo-->>Assigner: invigilators

    alt no invigilators
        Assigner-->>Controller: List<String> (empty / skipped)
        Controller-->>User: Show message (no invigilators)
    else has invigilators
        loop each ScheduledExam
            loop each ClassroomAllocation
                Assigner->>Alloc: getStudentCount()
                Alloc-->>Assigner: studentCount
                Assigner->>Assigner: calculateRequiredCount(studentCount)
                loop each Invigilator
                    Assigner->>Assigner: canSupervise(inv, exam)
                    Assigner->>Inv: isAvailable(slot)
                    Inv-->>Assigner: available
                end
                Assigner->>Assigner: selectBestCandidates(eligible, required)
                alt eligible < required
                    Assigner->>Assigner: recordUnderstaffedSlot(slot)
                end
                Assigner->>Alloc: setInvigilators(selected)
            end
        end
        Assigner->>Repo: saveSchedule(schedule)
        Repo-->>Assigner: saved
        Assigner-->>Controller: List<String>
        Controller-->>User: Show assignments & warnings
    end
